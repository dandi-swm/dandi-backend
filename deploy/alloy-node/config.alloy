// ──────────────────────────────────────────────────────────────
// 호스트(EC2) 지표. DAEMON으로 인스턴스마다 1개씩 뜬다.
//
// 컨테이너 안에서 /proc·/sys를 읽으면 "자기 네임스페이스"가 보이므로,
// 호스트의 것을 /host 아래로 마운트하고 경로를 바꿔 읽는다.
// 읽기 전용 마운트면 충분하고 privileged는 필요 없다.
// ──────────────────────────────────────────────────────────────
prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  // 컨테이너 overlay 파일시스템이 전부 잡히면 시계열이 불필요하게 늘어난다.
  filesystem {
    mount_points_exclude = "^/(dev|proc|sys|run|var/lib/docker/.+|host/(proc|sys))($|/)"
  }
}

// 인스턴스마다 다른 값이어야 두 호스트가 구분된다.
// Alloy 기본 instance 값은 컴포넌트 ID로 폴백해서 양쪽이 충돌한다.
discovery.relabel "node" {
  targets = prometheus.exporter.unix.node.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "node" {
  targets    = discovery.relabel.node.output
  forward_to = [prometheus.remote_write.grafana.receiver]

  job_name        = "integrations/node_exporter"
  scrape_interval = "60s"
}

prometheus.remote_write "grafana" {
  external_labels = {
    env = "prod",
  }

  endpoint {
    url = sys.env("GRAFANA_PROM_URL")
    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_PROM_PASSWORD")
    }
  }
}

// ──────────────────────────────────────────────────────────────
// 컨테이너별 지표. cAdvisor는 Docker 소켓과 cgroup을 직접 읽어야 해서
// privileged + 호스트 경로 마운트가 필요하다.
//
// node_exporter와 달리 경로 prefix 인자가 없다 → 호스트 경로를
// 컨테이너 안에서도 "같은 경로"에 마운트해야 한다.
// ──────────────────────────────────────────────────────────────
prometheus.exporter.cadvisor "docker" {
  docker_only = true

  // CFS 쿼터는 컨테이너가 아니라 태스크 cgroup에 걸린다.
  // docker_only가 raw cgroup을 건너뛰므로 여기서 예외로 허용한다.
  raw_cgroup_prefix_allowlist = ["/ecstasks.slice"]

  store_container_labels = false
  allowlisted_container_labels = [
    "com.amazonaws.ecs.container-name",
    "com.amazonaws.ecs.task-definition-family",
  ]
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.docker.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

prometheus.scrape "cadvisor" {
  targets    = discovery.relabel.cadvisor.output
  forward_to = [prometheus.relabel.cadvisor.receiver]

  job_name        = "integrations/cadvisor"
  scrape_interval = "60s"
}

// 15798은 by (container)로 묶는데 cAdvisor는 name만 낸다.
prometheus.relabel "cadvisor" {
  forward_to = [prometheus.remote_write.grafana.receiver]

  rule {
    source_labels = ["name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["container_label_com_amazonaws_ecs_container_name"]
    regex         = "(.+)"
    target_label  = "container"
  }
}