// ──────────────────────────────────────────────────────────────
// MySQL: Alloy가 RDS로 직접 나가서 붙는다.
// require_secure_transport는 꺼져 있어 TLS가 필수는 아니지만,
// skip-verify로 전송 구간은 암호화한다.
// ──────────────────────────────────────────────────────────────
prometheus.exporter.mysql "prod" {
  data_source_name = sys.env("MYSQL_EXPORTER_USER") + ":" +
                     sys.env("MYSQL_EXPORTER_PASSWORD") + "@(" +
                     sys.env("MYSQL_ADDRESS") + ")/?tls=skip-verify"

  // 기본 수집기(global_status, global_variables 등)에 더해서 켠다.
  // performance_schema=0 이므로 perf_schema.* 계열은 넣지 않는다.
  enable_collectors = [
    "info_schema.innodb_metrics",
    "info_schema.processlist",
    "engine_innodb_status",
  ]
}

// Alloy 자신의 상태. remote_write 파이프라인이 살아있는지
// MySQL 접속과 무관하게 확인할 수 있어 초기 검증에 쓴다.
prometheus.exporter.self "alloy" {}

prometheus.scrape "mysql" {
  targets    = discovery.relabel.mysql.output
  forward_to = [prometheus.remote_write.grafana.receiver]

  // t4g.micro(1GB)라 간격을 넉넉히 둔다.
  job_name        = "integrations/mysql"
  scrape_interval = "60s"
}

prometheus.scrape "alloy" {
  targets         = prometheus.exporter.self.alloy.targets
  forward_to      = [prometheus.remote_write.grafana.receiver]
  job_name        = "integrations/alloy"
  scrape_interval = "60s"
}

// ──────────────────────────────────────────────────────────────
// Valkey (ElastiCache) — 노드별로 exporter를 하나씩 둔다.
//
// 왜 노드별인가: primary/replica 역할은 페일오버로 뒤바뀌지만
//   노드 엔드포인트는 항상 같은 물리 노드를 가리킨다. 역할은
//   라벨에 박지 않고 redis_instance_info{role=} 지표로 읽는다.
//
// 왜 rediss:// 인가: TransitEncryptionMode가 required다.
//   ElastiCache 인증서는 공인 CA 체인이라 정식 검증이 된다.
//   (RDS는 사설 CA라 tls=skip-verify를 썼던 것과 다른 점)
//
// 왜 config_command를 끄나: ElastiCache가 CONFIG 명령을 막는다.
//   maxmemory는 INFO에서 나오므로 메모리 게이지는 영향 없다.
// ──────────────────────────────────────────────────────────────
prometheus.exporter.redis "valkey_001" {
  redis_addr     = "rediss://" + sys.env("VALKEY_001_ADDRESS")
  redis_password = sys.env("REDIS_PASSWORD")
  config_command = "-"
}

prometheus.exporter.redis "valkey_002" {
  redis_addr     = "rediss://" + sys.env("VALKEY_002_ADDRESS")
  redis_password = sys.env("REDIS_PASSWORD")
  config_command = "-"
}

// 대시보드 763은 instance와 namespace 두 라벨로 필터한다.
// Alloy 기본 instance 값은 문서화돼 있지 않으므로 직접 박는다.
discovery.relabel "valkey_001" {
  targets = prometheus.exporter.redis.valkey_001.targets

  rule {
    target_label = "instance"
    replacement  = "nyummy-prod-valkey-001"
  }
  rule {
    target_label = "namespace"
    replacement  = "nyummy-prod-valkey"
  }
}

discovery.relabel "valkey_002" {
  targets = prometheus.exporter.redis.valkey_002.targets

  rule {
    target_label = "instance"
    replacement  = "nyummy-prod-valkey-002"
  }
  rule {
    target_label = "namespace"
    replacement  = "nyummy-prod-valkey"
  }
}

prometheus.scrape "valkey" {
  targets = array.concat(
    discovery.relabel.valkey_001.output,
    discovery.relabel.valkey_002.output,
  )
  forward_to = [prometheus.remote_write.grafana.receiver]

  job_name        = "integrations/redis"
  scrape_interval = "60s"
}

prometheus.remote_write "grafana" {
  external_labels = {
    env = "prod",
  }

  endpoint {
    url = sys.env("GRAFANA_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_PROM_USER")
      password = sys.env("GRAFANA_PROM_PASSWORD")
    }
  }
}

// instance 라벨을 명시적으로 고정한다.
// 14031의 host 변수가 label_values(mysql_up, instance)라서
// 이 값이 대시보드 드롭다운에 그대로 뜬다.
// Alloy 기본값은 문서화돼 있지 않아(컴포넌트 ID로 폴백) 의존하지 않는다.
discovery.relabel "mysql" {
  targets = prometheus.exporter.mysql.prod.targets

  rule {
    target_label = "instance"
    replacement  = "nyummy-prod-mysql"
  }
}