# 이미지 발급·업로드는 image.http 참고 (purpose: INQUIRY → {{inquiryImageKey}})
# 답변 API는 아직 없다. 답변이 달린 상태는 DB에 직접 넣어 만든다 (answered_at 필수):
#   UPDATE inquiries SET answer_title = '답변 제목', answer_content = '답변 내용', answered_at = NOW()
#   WHERE id = {inquiryId} AND answered_at IS NULL;

### 문의하기 API (이미지 없음)
# X-App-Version이 inquiries.app_version에 저장된다.
POST {{url}}/api/v1/inquiries
Authorization: Bearer {{accessToken}}
Content-Type: application/json
X-App-Version: 1.0.0

{
  "category": "BUG_REPORT",
  "questionTitle": "식사 사진이 업로드되지 않아요",
  "questionContent": "갤러리에서 사진을 선택하면 로딩만 계속됩니다."
}

### 문의하기 API (이미지 첨부)
POST {{url}}/api/v1/inquiries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category": "QUESTION",
  "questionTitle": "캘린더 색은 무슨 뜻인가요?",
  "questionContent": "스크린샷의 초록색과 빨간색 차이가 궁금합니다.",
  "imageKey": "{{inquiryImageKey}}"
}

### 문의하기 API (앱 버전이 20자 초과)
# 문의는 생성되고 app_version은 null로 저장된다. 서버 로그에 warn이 남는다.
POST {{url}}/api/v1/inquiries
Authorization: Bearer {{accessToken}}
Content-Type: application/json
X-App-Version: 1.0.0-very-long-build-name

{
  "category": "QUESTION",
  "questionTitle": "앱 버전이 긴 문의",
  "questionContent": "app_version은 null이어야 합니다."
}

### [실패] 이미 문의에 사용된 imageKey로 문의하기 → api.inquiry.duplicateImageKey
# 바로 위 요청을 성공시킨 뒤 같은 키로 다시 보낸다.
POST {{url}}/api/v1/inquiries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category": "QUESTION",
  "questionTitle": "같은 이미지로 한 번 더",
  "questionContent": "중복 키는 거부되어야 합니다.",
  "imageKey": "{{inquiryImageKey}}"
}

### [실패] 식사 용도로 발급받은 키로 문의하기 → api.s3.invalidKey
POST {{url}}/api/v1/inquiries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category": "BUG_REPORT",
  "questionTitle": "식사 키로 문의",
  "questionContent": "inquiries/{userId}/ 경로가 아니므로 거부되어야 합니다.",
  "imageKey": "{{imageKey}}"
}

### [실패] 제목이 비었거나 존재하지 않는 유형 → 400
POST {{url}}/api/v1/inquiries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category": "COMPLAINT",
  "questionTitle": "",
  "questionContent": "내용"
}

### 문의 목록 조회 API (첫 요청)
# 응답의 nextCursor를 아래 @cursor에 옮겨 담는다. hasNext가 false면 마지막 묶음이다.
GET {{url}}/api/v1/inquiries?size=2
Authorization: Bearer {{accessToken}}

### 문의 목록 조회 API (다음 묶음)
@cursor = 10
GET {{url}}/api/v1/inquiries?cursor={{cursor}}&size=2
Authorization: Bearer {{accessToken}}

### [실패] size 범위(1~50) 초과 → 400
GET {{url}}/api/v1/inquiries?size=51
Authorization: Bearer {{accessToken}}

### 문의 상세 조회 API
# 답변이 달린 문의를 처음 조회하면 answer_read_at이 기록된다. 받을 수 있는 우편도 없으면 홈의 hasMailboxBadge가 false가 된다.
@inquiryId = 1
GET {{url}}/api/v1/inquiries/{{inquiryId}}
Authorization: Bearer {{accessToken}}

### 문의 수정 API (이미지 유지: 기존 imageKey를 그대로 보낸다)
PUT {{url}}/api/v1/inquiries/{{inquiryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category": "SUGGESTION",
  "questionTitle": "제목 수정",
  "questionContent": "내용 수정",
  "imageKey": "{{inquiryImageKey}}"
}

### 문의 수정 API (이미지 삭제: imageKey 생략 또는 null)
PUT {{url}}/api/v1/inquiries/{{inquiryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category": "SUGGESTION",
  "questionTitle": "제목 수정",
  "questionContent": "이미지를 지웁니다.",
  "imageKey": null
}

### 문의 수정 API (이미지 교체: image.http에서 새로 발급·업로드한 키)
PUT {{url}}/api/v1/inquiries/{{inquiryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category": "SUGGESTION",
  "questionTitle": "제목 수정",
  "questionContent": "새 이미지로 교체합니다.",
  "imageKey": "{{newInquiryImageKey}}"
}

### [실패] 답변이 달린 문의 수정 → api.inquiry.alreadyAnswered
# 상단 주석의 SQL로 답변을 넣은 문의 id를 사용한다.
@answeredInquiryId = 2
PUT {{url}}/api/v1/inquiries/{{answeredInquiryId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "category": "QUESTION",
  "questionTitle": "답변 후 수정",
  "questionContent": "거부되어야 합니다."
}

### [실패] 다른 사용자의 문의 조회 → api.auth.forbidden
@otherUserInquiryId = 999
GET {{url}}/api/v1/inquiries/{{otherUserInquiryId}}
Authorization: Bearer {{accessToken}}

### 문의 삭제 API (답변이 달린 문의도 삭제 가능)
DELETE {{url}}/api/v1/inquiries/{{inquiryId}}
Authorization: Bearer {{accessToken}}

### [실패] 이미 삭제된 문의 삭제 → api.inquiry.notFound
DELETE {{url}}/api/v1/inquiries/{{inquiryId}}
Authorization: Bearer {{accessToken}}

### 문의 복구 API (삭제한 문의 되돌리기)
# 삭제되지 않은 문의에 다시 보내도 204다(멱등).
POST {{url}}/api/v1/inquiries/{{inquiryId}}/restore
Authorization: Bearer {{accessToken}}

### [실패] 다른 사용자의 문의 복구 → api.auth.forbidden
POST {{url}}/api/v1/inquiries/{{otherUserInquiryId}}/restore
Authorization: Bearer {{accessToken}}
