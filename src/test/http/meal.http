    X-Amz-Credential=AKIAWUFGFGKM4PNRWFHW%2F20260806%2Fap-northeast-2%2Fs3%2Faws4_request&X-Amz-Date=20260806T054450Z&
    X-Amz-Expires=600&X-Amz-SignedHeaders=content-type%3Bhost&
