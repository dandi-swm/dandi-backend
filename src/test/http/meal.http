# 이미지 발급·업로드는 image.http 참고 (purpose: MEAL)
# 하루 기록 시도 횟수(5회)를 넘기면 발급 단계에서 api.meal.dailyCountExceeded로 거부된다.

### 식사기록 생성 API
POST {{url}}/api/v1/meals
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "imageKey": "{{imageKey}}"
}

### [실패] 문의 용도로 발급받은 키로 식사기록 생성 → api.s3.invalidKey
POST {{url}}/api/v1/meals
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "imageKey": "{{inquiryImageKey}}"
}

### [실패] 오늘 촬영하지 않은 사진으로 식사기록 생성 → api.meal.staleImage
# image.http에서 어제 이전에 촬영한(EXIF 있는) 사진을 업로드한 뒤 그 키를 넣는다.
# 거부 후 S3 콘솔에서 객체 태그가 status=temp로 남아 있는지 확인한다.
POST {{url}}/api/v1/meals
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "imageKey": "{{staleImageKey}}"
}

### 튜토리얼 식사 생성 API
# 요청 본문 없음. 보상 상자 우편이 하나 생긴다(mail.http로 확인).
# 이미 튜토리얼을 마친 사용자가 다시 보내면 api.meal.tutorialAlreadyCompleted로 거부된다.
POST {{url}}/api/v1/meals/tutorial
Authorization: Bearer {{accessToken}}

### 분석 상태 조회 API
# 시드 데이터 기준: 4=FAILED (재분석은 WAITING/FAILED만 허용)
@analysisMealId = 4
GET {{url}}/api/v1/meals/{{analysisMealId}}/analysis
Authorization: Bearer {{accessToken}}

### 재분석 요청 API
# FAILED 식사만 다시 분석한다. v2 API로 기록한 식사는 처음부터 다시 인식해 RECOGNIZING으로 응답한다.
POST {{url}}/api/v1/meals/{{analysisMealId}}/analysis
Authorization: Bearer {{accessToken}}

### 월간 식사 캘린더 조회 API
GET {{url}}/api/v1/meals/monthly?year=2026&month=9
Authorization: Bearer {{accessToken}}

### 일일 식사 목록 조회 API
GET {{url}}/api/v1/meals/daily?year=2026&month=9&day=1
Authorization: Bearer {{accessToken}}

### 식사 단건 조회 API
# 시드 데이터 기준: 1~3=COMPLETED
@mealId = 1
GET {{url}}/api/v1/meals/{{mealId}}
Authorization: Bearer {{accessToken}}

### 식사 이름 수정 API
PUT {{url}}/api/v1/meals/{{mealId}}?name=김치찌개
Authorization: Bearer {{accessToken}}

### 식사 영양 수정 API
# 바꾸려는 항목만 보낸다. 생략하거나 null로 보낸 항목은 유지되고, 0은 0으로 수정한다.
# 칼로리는 0~9999, 탄수화물·단백질·지방은 0~999. 분석이 완료된(COMPLETED) 식사만 수정할 수 있다.
PATCH {{url}}/api/v1/meals/{{mealId}}/nutrition
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "calory": 520,
  "carbs": 80
}

### [실패] 범위를 벗어난 값으로 영양 수정 → api.common.invalidInputValue
PATCH {{url}}/api/v1/meals/{{mealId}}/nutrition
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "calory": -1
}

### [실패] 분석이 완료되지 않은 식사의 영양 수정 → api.meal.analysisNotCompleted
PATCH {{url}}/api/v1/meals/{{analysisMealId}}/nutrition
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "carbs": 80
}

### 식사 삭제 API
DELETE {{url}}/api/v1/meals/{{mealId}}
Authorization: Bearer {{accessToken}}

### 영양 분석 피드백 생성 API
POST {{url}}/api/v1/meals/{{mealId}}/analysis/feedback
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "rating": 3.5,
  "reason": "꽤 괜찮네요!"
}
########################################################################################################################
# 식사 인식 v2 (/api/v2/meals)
# 식사를 기록하면 서버가 5초 안에 음식 줄(이름·인분)을 인식해 주고, 영양은 Worker가 따로 계산한다.
# 상태: RECOGNIZING(인식 중) → CONFIRMING(음식 목록 있음, 사용자의 확인을 기다림) → WAITING(계산 대기) → ANALYZING → COMPLETED
# 음식 목록은 CONFIRMING과 COMPLETED에서만 보낼 수 있다. 계산을 시작한 식사(WAITING·ANALYZING)는 끝날 때까지 고칠 수 없다.
########################################################################################################################

### 식사기록 생성 API v2
# 5초 안에 인식하면 status가 CONFIRMING이고 name·foods가 온다(줄 영양과 iconId는 null).
# 5초 안에 못 끝내면 RECOGNIZING이고 name·foods가 null이다. 음식이 아니면 FAILED다.
# 응답의 id를 아래 @mealIdV2에 넣는다.
POST {{url}}/api/v2/meals
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "imageKey": "{{imageKey}}"
}

### [실패] 같은 사진으로 다시 기록 → api.meal.duplicateImageKey
POST {{url}}/api/v2/meals
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "imageKey": "{{imageKey}}"
}

### 분석 상태 조회 API v2
# RECOGNIZING이면 CONFIRMING이 될 때까지, 음식 목록을 보낸 뒤에는 COMPLETED가 될 때까지 다시 부른다.
# 목록을 보내지 않으면 CONFIRMING에 머물다가 5분 뒤에 Worker가 계산해 COMPLETED가 된다.
@mealIdV2 = 1
GET {{url}}/api/v2/meals/{{mealIdV2}}/analysis
Authorization: Bearer {{accessToken}}

### 식사 단건 조회 API v2
# analysisVersion이 V2이고 foods에 음식 줄이 순서대로 온다. 계산 전이면 줄의 nutrition·iconId와 catComment가 null이다.
# V1 식사(v1 API로 만든 식사)는 analysisVersion이 V1이고 foods가 null이다.
GET {{url}}/api/v2/meals/{{mealIdV2}}
Authorization: Bearer {{accessToken}}

### 일일 식사 목록 조회 API v2
# 식사마다 analysisVersion(V1·V2)이 온다. 계산이 끝나지 않은 식사는 영양이 0이다.
GET {{url}}/api/v2/meals/daily?year=2026&month=11&day=14
Authorization: Bearer {{accessToken}}

### 식사 이름 수정 API v2
# 대표 이름(1~20자)을 본문으로 보낸다. 음식 줄과 영양은 그대로이고 다시 계산하지 않는다.
# 응답은 단건 조회와 같은 모양이다.
PUT {{url}}/api/v2/meals/{{mealIdV2}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "점심 불고기 백반"
}

### [실패] 20자를 넘는 이름으로 수정 → api.common.invalidInputValue
PUT {{url}}/api/v2/meals/{{mealIdV2}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "스무 글자를 넘기려고 일부러 길게 쓴 대표 이름"
}

### 음식 목록 보내기 API v2 (그대로 보내기)
# 목록 화면의 버튼이다. 고치지 않았어도 단건 조회에서 받은 foods의 mealFoodId·name·portion을 그대로 보낸다.
# CONFIRMING인 식사면 기다리던 계산(5분 뒤)을 버리고 바로 계산한다. 응답의 status가 WAITING이면 분석 상태가 COMPLETED가 될 때까지 폴링한 뒤
# 단건을 다시 조회하고, COMPLETED면 이미 계산이 끝난 것이므로 바로 단건을 다시 조회한다.
# COMPLETED는 한 번 계산이 끝난 식사에서 새로 구할 값이 없을 때다(인분·순서만 바꿈, 줄을 지움, 영양·아이콘을 직접 적음).
# 아래 @mealFoodId1·@mealFoodId2에 단건 조회의 foods[].mealFoodId를 넣는다.
@mealFoodId1 = 1
@mealFoodId2 = 2
PUT {{url}}/api/v2/meals/{{mealIdV2}}/foods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "foods": [
    { "mealFoodId": {{mealFoodId1}}, "name": "불고기", "portion": 1.5 },
    { "mealFoodId": {{mealFoodId2}}, "name": "잡곡밥", "portion": 1.0 }
  ]
}

### 음식 목록 보내기 API v2 (이름·인분 고치기, 줄 추가, 순서 바꾸기)
# 맨 위 줄이 대표 음식이고 그 줄의 아이콘이 식사 아이콘이 된다. 이름을 바꾼 줄은 영양과 아이콘을 다시 구한다.
# mealFoodId가 null인 줄은 새 줄이다. 요청에 없는 기존 줄은 지워진다.
PUT {{url}}/api/v2/meals/{{mealIdV2}}/foods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "foods": [
    { "mealFoodId": {{mealFoodId2}}, "name": "잡곡밥", "portion": 2.0 },
    { "mealFoodId": {{mealFoodId1}}, "name": "제육볶음", "portion": 1.5 },
    { "mealFoodId": null, "name": "김치", "portion": 0.5 }
  ]
}

### 음식 목록 보내기 API v2 (영양·아이콘 직접 고치기)
# nutrition을 채운 줄은 그 값으로 고정된다(1인분 = 값 ÷ 인분). iconId를 채운 줄은 그 아이콘으로 고정된다.
# 고정된 줄은 이름을 바꿔도 다시 구하지 않는다. 단건 조회에서 isNutritionFixed가 true로 온다.
PUT {{url}}/api/v2/meals/{{mealIdV2}}/foods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "foods": [
    {
      "mealFoodId": {{mealFoodId1}},
      "name": "불고기",
      "portion": 1.5,
      "nutrition": { "calory": 415, "carbs": 30, "protein": 27, "fat": 21 },
      "iconId": 5
    },
    { "mealFoodId": {{mealFoodId2}}, "name": "잡곡밥", "portion": 1.0 }
  ]
}

### [실패] 0.5 단위가 아닌 인분 → api.common.invalidInputValue
PUT {{url}}/api/v2/meals/{{mealIdV2}}/foods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "foods": [
    { "mealFoodId": {{mealFoodId1}}, "name": "불고기", "portion": 1.3 }
  ]
}

### [실패] 빈 목록 → api.common.invalidInputValue
PUT {{url}}/api/v2/meals/{{mealIdV2}}/foods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "foods": []
}

### [실패] 없는 아이콘 id → api.common.invalidInputValue
PUT {{url}}/api/v2/meals/{{mealIdV2}}/foods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "foods": [
    { "mealFoodId": {{mealFoodId1}}, "name": "불고기", "portion": 1.5, "iconId": 999999 }
  ]
}

### [실패] 이 식사의 줄이 아닌 mealFoodId → api.meal.mealFoodNotFound (404)
PUT {{url}}/api/v2/meals/{{mealIdV2}}/foods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "foods": [
    { "mealFoodId": 999999, "name": "불고기", "portion": 1.5 }
  ]
}

### [실패] 인식 중이거나 계산을 시작했거나 실패한 식사, V1 식사에 보내기 → api.meal.mealFoodsNotUpdatable
# @notUpdatableMealId에 status가 RECOGNIZING·WAITING·ANALYZING·FAILED인 V2 식사나 V1 식사의 id를 넣는다.
# 목록을 보낸 직후(WAITING·ANALYZING)에 같은 요청을 한 번 더 보내면 이 응답을 볼 수 있다.
@notUpdatableMealId = 4
PUT {{url}}/api/v2/meals/{{notUpdatableMealId}}/foods
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "foods": [
    { "mealFoodId": null, "name": "불고기", "portion": 1.0 }
  ]
}

### 음식 줄 수정 API v2 (인분 고치기)
# 계산이 끝난(COMPLETED) 식사의 한 줄을 고친다. 바꾸려는 항목만 보낸다. 응답은 204이고 본문이 없으므로 단건을 다시 조회한다.
# 인분·영양·아이콘만 고치면 식사는 COMPLETED로 남고 합계가 바로 바뀐다.
# CONFIRMING인 식사는 이 API로 고칠 수 없다. 위의 음식 목록 보내기로 한 번에 고친다.
PATCH {{url}}/api/v2/meals/{{mealIdV2}}/foods/{{mealFoodId1}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "portion": 2.0
}

### 음식 줄 수정 API v2 (이름 고치기)
# 이름을 바꾸면 그 줄의 영양과 아이콘을 다시 구한다(고정한 값은 그대로). 식사가 WAITING이 되므로 단건을 다시 조회한 뒤
# 분석 상태가 COMPLETED가 될 때까지 폴링한다. 그동안은 음식 줄을 고칠 수 없다. 다시 계산이 끝나도 완료 푸시는 가지 않는다.
PATCH {{url}}/api/v2/meals/{{mealIdV2}}/foods/{{mealFoodId1}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "제육볶음"
}

### 음식 줄 수정 API v2 (영양·아이콘 직접 고치기)
# nutrition을 보내면 그 값으로 고정된다(1인분 = 값 ÷ 인분). iconId를 보내면 그 아이콘으로 고정된다.
# 단건 조회에서 isNutritionFixed가 true로 온다.
PATCH {{url}}/api/v2/meals/{{mealIdV2}}/foods/{{mealFoodId2}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "nutrition": { "calory": 310, "carbs": 68, "protein": 7, "fat": 1 },
  "iconId": 5
}

### [실패] 바꾸려는 항목이 없는 본문 → api.common.invalidInputValue
PATCH {{url}}/api/v2/meals/{{mealIdV2}}/foods/{{mealFoodId1}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{}

### [실패] 0.5 단위가 아닌 인분으로 고치기 → api.common.invalidInputValue
PATCH {{url}}/api/v2/meals/{{mealIdV2}}/foods/{{mealFoodId1}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "portion": 0.7
}

### [실패] 이 식사의 줄이 아닌 mealFoodId를 고치기 → api.meal.mealFoodNotFound (404)
PATCH {{url}}/api/v2/meals/{{mealIdV2}}/foods/999999
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "portion": 1.0
}

### [실패] 계산이 끝나지 않은 식사, V1 식사의 줄을 고치기 → api.meal.mealFoodsNotUpdatable
# @notUpdatableMealId에 status가 COMPLETED가 아닌 V2 식사(CONFIRMING 포함)나 V1 식사의 id를 넣는다.
PATCH {{url}}/api/v2/meals/{{notUpdatableMealId}}/foods/{{mealFoodId1}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "portion": 1.0
}

### 음식 줄 삭제 API v2
# 계산이 끝난(COMPLETED) 식사의 한 줄을 지운다. 남은 줄의 순서를 다시 매기고, 맨 위 줄을 지우면 다음 줄이 대표 음식이 된다.
# 식사의 합계와 아이콘은 남은 줄로 바로 바뀐다. 응답은 204이고 본문이 없으므로 단건을 다시 조회한다.
# CONFIRMING인 식사는 이 API로 지울 수 없다. 줄을 뺀 목록을 위의 음식 목록 보내기로 보낸다.
DELETE {{url}}/api/v2/meals/{{mealIdV2}}/foods/{{mealFoodId2}}
Authorization: Bearer {{accessToken}}

### [실패] 하나 남은 줄을 삭제 → api.meal.lastMealFoodNotDeletable
# 위 요청으로 한 줄만 남긴 뒤 남은 줄의 id로 보낸다.
DELETE {{url}}/api/v2/meals/{{mealIdV2}}/foods/{{mealFoodId1}}
Authorization: Bearer {{accessToken}}

### [실패] 이 식사의 줄이 아닌 mealFoodId를 삭제 → api.meal.mealFoodNotFound (404)
DELETE {{url}}/api/v2/meals/{{mealIdV2}}/foods/999999
Authorization: Bearer {{accessToken}}

### [실패] 계산이 끝나지 않은 식사, V1 식사의 줄을 삭제 → api.meal.mealFoodsNotUpdatable
# @notUpdatableMealId에 status가 COMPLETED가 아닌 V2 식사(CONFIRMING 포함)나 V1 식사의 id를 넣는다.
DELETE {{url}}/api/v2/meals/{{notUpdatableMealId}}/foods/{{mealFoodId1}}
Authorization: Bearer {{accessToken}}

### 식사 기록 취소 API v2
# 기록 직후 음식 목록 화면의 X 버튼이다. 식사를 삭제하고 기다리던 영양 계산을 없앤다.
# 하루 기록 횟수, 보상 상자, 연속 기록은 되돌아가지 않는다. 응답은 204이고 본문이 없다.
POST {{url}}/api/v2/meals/{{mealIdV2}}/cancel
Authorization: Bearer {{accessToken}}

### 식사 삭제 API v2
# 기록 취소와 하는 일이 같다. 지운 뒤 단건 조회는 api.meal.notFound다.
DELETE {{url}}/api/v2/meals/{{mealIdV2}}
Authorization: Bearer {{accessToken}}

### [실패] 이미 지운 식사를 다시 삭제 → api.meal.notFound
DELETE {{url}}/api/v2/meals/{{mealIdV2}}
Authorization: Bearer {{accessToken}}

### 재분석 요청 API v2
# FAILED 식사만 다시 분석한다. V2 식사는 어느 단계에서 실패했든 처음부터 다시 인식한다.
# 음식 줄을 지우고 RECOGNIZING으로 응답한다. 인식이 끝나면 CONFIRMING이 되고, 5분 뒤(또는 목록을 보내면 바로) 영양을 계산한다.
# V1 식사는 v1과 같이 WAITING으로 응답한다.
@failedMealIdV2 = 4
POST {{url}}/api/v2/meals/{{failedMealIdV2}}/analysis
Authorization: Bearer {{accessToken}}

### [실패] FAILED가 아닌 식사를 재분석 → api.meal.analysisNotRetryable
POST {{url}}/api/v2/meals/{{mealIdV2}}/analysis
Authorization: Bearer {{accessToken}}
